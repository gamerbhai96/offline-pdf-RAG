{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://offline-doc-intelligence/schemas/Evidence.json",
  "title": "Evidence",
  "description": "A validated evidence chunk with retrieval signals",
  "type": "object",
  "required": ["evidence_id", "chunk_id", "document_id", "page_number", "text", "validation_passed"],
  "properties": {
    "evidence_id":        { "type": "string", "format": "uuid" },
    "chunk_id":           { "type": "string", "format": "uuid" },
    "document_id":        { "type": "string", "format": "uuid" },
    "page_number":        { "type": "integer", "minimum": 1 },
    "text":               { "type": "string" },
    "dense_score":        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "bm25_score":         { "type": "number", "minimum": 0.0 },
    "fusion_score":       { "type": "number" },
    "validation_score":   { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "validation_passed":  { "type": "boolean" },
    "bounding_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x0", "y0", "x1", "y1", "page"],
        "properties": {
          "x0":  { "type": "number" },
          "y0":  { "type": "number" },
          "x1":  { "type": "number" },
          "y1":  { "type": "number" },
          "page": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
