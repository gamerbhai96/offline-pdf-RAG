{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://offline-doc-intelligence/schemas/Chunk.json",
  "title": "Chunk",
  "description": "A text segment from a document used for indexing and retrieval",
  "type": "object",
  "required": [
    "chunk_id", "document_id", "page_id", "text",
    "token_count", "start_offset", "end_offset",
    "chunk_index", "chunk_type", "strategy", "strategy_version"
  ],
  "properties": {
    "chunk_id":          { "type": "string", "format": "uuid" },
    "document_id":       { "type": "string", "format": "uuid" },
    "page_id":           { "type": "string", "format": "uuid" },
    "section_id":        { "type": ["string", "null"], "format": "uuid" },
    "text":              { "type": "string", "minLength": 1 },
    "token_count":       { "type": "integer", "minimum": 1 },
    "start_offset":      { "type": "integer", "minimum": 0 },
    "end_offset":        { "type": "integer", "minimum": 0 },
    "bounding_boxes": {
      "type": "array",
      "items": { "$ref": "#/definitions/BoundingBox" }
    },
    "chunk_index":       { "type": "integer", "minimum": 0 },
    "parent_chunk_id":   { "type": ["string", "null"], "format": "uuid" },
    "chunk_type": {
      "type": "string",
      "enum": ["TEXT", "TABLE", "LIST", "HEADING"]
    },
    "strategy": {
      "type": "string",
      "enum": ["HEADING_AWARE", "PARAGRAPH", "FIXED_OVERLAP", "SENTENCE"]
    },
    "strategy_version":  { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" }
  },
  "definitions": {
    "BoundingBox": {
      "type": "object",
      "required": ["x0", "y0", "x1", "y1", "page"],
      "properties": {
        "x0":  { "type": "number" },
        "y0":  { "type": "number" },
        "x1":  { "type": "number" },
        "y1":  { "type": "number" },
        "page": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
