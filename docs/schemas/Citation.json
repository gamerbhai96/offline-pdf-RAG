{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://offline-doc-intelligence/schemas/Citation.json",
  "title": "Citation",
  "description": "Source citation linking an answer point to a document page and bounding box",
  "type": "object",
  "required": [
    "citation_id", "answer_id", "evidence_id", "chunk_id",
    "document_id", "page_number", "highlighted_text"
  ],
  "properties": {
    "citation_id":        { "type": "string", "format": "uuid" },
    "answer_id":          { "type": "string", "format": "uuid" },
    "evidence_id":        { "type": "string", "format": "uuid" },
    "chunk_id":           { "type": "string", "format": "uuid" },
    "document_id":        { "type": "string", "format": "uuid" },
    "document_title":     { "type": ["string", "null"] },
    "page_number":        { "type": "integer", "minimum": 1 },
    "section_heading":    { "type": ["string", "null"] },
    "highlighted_text":   { "type": "string", "minLength": 1 },
    "bounding_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x0", "y0", "x1", "y1", "page"],
        "properties": {
          "x0":  { "type": "number" },
          "y0":  { "type": "number" },
          "x1":  { "type": "number" },
          "y1":  { "type": "number" },
          "page": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
