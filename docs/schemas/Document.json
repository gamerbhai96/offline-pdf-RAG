{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://offline-doc-intelligence/schemas/Document.json",
  "title": "Document",
  "type": "object",
  "required": ["document_id", "file_path", "file_hash", "page_count", "created_at"],
  "properties": {
    "document_id":  { "type": "string", "format": "uuid" },
    "file_path":    { "type": "string" },
    "file_hash":    { "type": "string", "minLength": 64, "maxLength": 64, "description": "SHA-256" },
    "title":        { "type": ["string", "null"] },
    "page_count":   { "type": "integer", "minimum": 1 },
    "language":     { "type": "string", "default": "en", "description": "BCP 47" },
    "indexed_at":   { "type": ["string", "null"], "format": "date-time" },
    "model_id":     { "type": ["string", "null"] },
    "created_at":   { "type": "string", "format": "date-time" }
  }
}
